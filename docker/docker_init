#!/bin/sh
# Writes non-secret settings. Secrets (NBE_PASS, MQTT_PASS) stay in the environment only.
set -eu

: "${NBE_SERIAL:?NBE_SERIAL is required}"
: "${NBE_IP:?NBE_IP is required}"
: "${NBE_PASS:?NBE_PASS is required}"
: "${MQTT_IP:?MQTT_IP is required}"
: "${MQTT_PASS:?MQTT_PASS is required}"

python3 - <<'PY'
import json, os
cfg = {
    "nbe_serial": os.environ["NBE_SERIAL"],
    "nbe_ip": os.environ["NBE_IP"],
    "nbe_port": int(os.environ.get("NBE_PORT", "8483")),
    "mqtt_server": os.environ["MQTT_IP"],
    "mqtt_port": int(os.environ.get("MQTT_PORT", "1883")),
    "mqtt_user": os.environ.get("MQTT_USER", ""),
    "mqtt_client_name": os.environ.get("MQTT_CLIENT_NAME", "pellet-burner"),
    "debug": os.environ.get("DEBUG", "false") == "true",
    "refresh_rate": int(os.environ.get("REFRESH_RATE", "60")),
    "ha_prefix": os.environ.get("HA_PREFIX", "homeassistant"),
}
with open("/app/config.json", "w") as f:
    json.dump(cfg, f, indent=1)
PY

echo "Config written, starting..."
cd /app
exec python3 /app/nbe.py
